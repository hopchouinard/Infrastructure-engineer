# UniFi Documentation Crawler Environment Variables
# Copy to .env and customize

# Output directory (overrides config.yaml)
# CRAWLER_OUTPUT_DIR=ai_docs/vendor/unifi

# Rate limiting
# CRAWLER_RATE_LIMIT__REQUESTS_PER_SECOND=1.0
# CRAWLER_RATE_LIMIT__RESPECT_ROBOTS_TXT=true

# Help Center source
# CRAWLER_SOURCES__HELP_CENTER__ENABLED=true
# CRAWLER_SOURCES__HELP_CENTER__BASE_URL=https://help.ui.com/hc/en-us

# Guides source
# CRAWLER_SOURCES__GUIDES__ENABLED=true
# CRAWLER_SOURCES__GUIDES__BASE_URL=https://dl.ubnt.com/guides/UniFi/

# State management
# CRAWLER_STATE_FILE=crawl-state.json
# CRAWLER_STATE_SAVE_INTERVAL=50
